# IDE 配置文件
.idea/

# 环境变量 / API Key —— 绝对不能上传，包含真实密钥
.env

# Python 虚拟环境
venv/

# Python 缓存
__pycache__/
*.pyc

# 向量数据库（实验产物，体积大，靠 ingest.py 重新生成）
data/chroma_db/

# 拉取的原始文档（靠 fetch_docs.py 重新生成，不需要进仓库）
data/raw_docs/

# 临时克隆的完整仓库（脚本运行时的中间产物，正常情况下会被脚本自动清理）
data/_langchain_repo/

# 评估结果（可选：如果你想保留这个作为实验记录证据，可以把这行删掉不忽略）
# eval/results.json